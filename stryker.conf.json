{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing config. Run with `npm run test:mutate`. Stryker flips operators, negations, boundaries, etc. in src/ and runs the unit suite against each mutation — any mutation the tests fail to kill signals a weak assertion.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.ts",
    "enableFindRelatedTests": true
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "reporters": ["progress", "clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.d.ts",
    "!src/**/index.ts",
    "!src/**/types/**",
    "!src/**/constants.ts"
  ],
  "ignorePatterns": [
    "dist",
    "coverage",
    "docs",
    "node_modules",
    "reports",
    ".stryker-tmp"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "disableTypeChecks": "{src,test}/**/*.{ts,tsx}",
  "incremental": true,
  "incrementalFile": ".stryker-incremental.json"
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/index.ts!",
    "examples/*.mjs",
    "scripts/*.mjs",
    ".github/scripts/*.mjs",
    "*.config.ts",
    "jest*.config.mjs",
    "test/**/*.test.ts",
    "test/package-smoke/*.test.mjs",
    "test/scripts/*.test.mjs"
  ],
  "project": ["src/**/*.ts", "test/**/*.ts"]
}

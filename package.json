{
  "name": "@farukada/aws-langgraph-dynamodb-ts",
  "version": "0.2.0",
  "license": "MIT",
  "description": "AWS DynamoDB implementation for LangGraph Memory Store and Checkpoint Saver in TypeScript",
  "keywords": [
    "aws",
    "dynamodb",
    "langchain",
    "langgraph",
    "checkpointer",
    "memory-store"
  ],
  "author": "Faruk Ada <info@farukada.com>",
  "homepage": "https://github.com/farukada/aws-langgraph-dynamodb-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/farukada/aws-langgraph-dynamodb-ts"
  },
  "bugs": {
    "url": "https://github.com/farukada/aws-langgraph-dynamodb-ts/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "jest",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.ts",
    "test:integration:up": "docker compose up -d",
    "test:integration:down": "docker compose down",
    "test:mutate": "stryker run",
    "test:mutate:quick": "stryker run --mutate src/shared/utils/retry.ts,src/shared/utils/compressor.ts,src/store/utils/filter.ts",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "unused": "knip",
    "depcheck": "depcheck .",
    "cpd": "jscpd ./src --threshold 2 --min-lines 3 --reporters console --silent --format typescript,javascript",
    "cpd:full": "jscpd ./src --threshold 2 --min-lines 3 --reporters console --verbose --format typescript,javascript",
    "cpd:test": "jscpd ./test --threshold 2 --min-lines 3 --reporters console --verbose --format typescript,javascript"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1031.0",
    "@aws-sdk/lib-dynamodb": "^3.1031.0",
    "@langchain/aws": "^1.3.5",
    "@langchain/core": "^1.1.40",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint": "^1.0.1",
    "jsonpath-plus": "^10.4.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.900.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1031.0",
    "@aws-sdk/client-s3": "^3.1031.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "aws-sdk-client-mock": "^4.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-perfectionist": "^5.8.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "jest": "^30.3.0",
    "jest-sonar": "^0.2.16",
    "jiti": "^2.6.1",
    "jscpd": "^4.0.9",
    "knip": "^6.4.1",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}

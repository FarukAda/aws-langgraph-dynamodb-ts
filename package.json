{
  "name": "@farukada/aws-langgraph-dynamodb-ts",
  "version": "0.3.0",
  "license": "MIT",
  "description": "AWS DynamoDB implementation for LangGraph Memory Store and Checkpoint Saver in TypeScript",
  "keywords": [
    "aws",
    "dynamodb",
    "langchain",
    "langgraph",
    "checkpointer",
    "memory-store"
  ],
  "author": "Faruk Ada <info@farukada.com>",
  "homepage": "https://github.com/FarukAda/aws-langgraph-dynamodb-ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/FarukAda/aws-langgraph-dynamodb-ts"
  },
  "bugs": {
    "url": "https://github.com/FarukAda/aws-langgraph-dynamodb-ts/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.config.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"*.config.ts\" --fix --no-error-on-unmatched-pattern",
    "test": "jest",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.ts",
    "test:integration:up": "docker compose up -d",
    "test:integration:down": "docker compose down",
    "test:conformance": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.conformance.config.ts",
    "test:aws": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.aws.config.ts",
    "test:static": "jest test/static",
    "test:package-smoke": "node --test test/package-smoke/smoke.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "unused": "knip",
    "depcheck": "depcheck .",
    "cpd": "jscpd ./src --threshold 2 --min-lines 3 --reporters console --silent --format typescript,javascript",
    "cpd:full": "jscpd ./src --threshold 2 --min-lines 3 --reporters console --verbose --format typescript,javascript",
    "cpd:test": "jscpd ./test --threshold 2 --min-lines 3 --reporters console --verbose --format typescript,javascript"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1057.0",
    "@aws-sdk/lib-dynamodb": "^3.1057.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph-checkpoint": "^1.0.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@langchain/langgraph": "^1.3.2"
  },
  "overrides": {
    "uuid": ">=11.1.1"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@eslint/js": "^10.0.1",
    "@langchain/aws": "^1.3.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "aws-sdk-client-mock": "^4.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-instanceof": "^1.0.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "expect-type": "^1.3.0",
    "fast-check": "^4.8.0",
    "jest": "^30.4.2",
    "jest-sonar": "^0.2.16",
    "jiti": "^2.7.0",
    "jscpd": "^4.2.4",
    "knip": "^6.14.2",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.3.6"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
